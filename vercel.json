{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix straxonsecure install",
  "buildCommand": "npm --prefix straxonsecure run build",
  "outputDirectory": "straxonsecure/dist/client",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
