# We use Node to build and run the TanStack Start preview server
FROM node:20-alpine

WORKDIR /app

# Install all dependencies (including devDependencies required for Vite preview)
COPY package*.json ./
RUN npm install

COPY . .

# Build the production bundle
RUN npm run build

# Expose port 80 for K8s ingress mapping
EXPOSE 80

# Serve the build using Vite's preview server
CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "80"]
