# Straxon Labs — Environment Variables
# Copy this file to .env and fill in real values before deploying

# ─── Required ───────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-for-access-tokens
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-for-refresh

# ─── Optional (features will degrade gracefully without these) ───────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/straxon_v2?schema=public
RESEND_API_KEY=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
